{
  "name": "karnataka-travel-diaries",
  "version": "1.0.0",
  "private": true,
  "description": "Karnataka Travel Diaries - Official Karnataka Discovery Companion built with Vanilla HTML5, CSS3, and JavaScript.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "prisma generate && node scripts/generateSitemap.mjs --prod",
    "sitemap": "node scripts/generateSitemap.mjs --prod",
    "test": "node scripts/verifyAllAuth.mjs",
    "test:auth": "node scripts/testAuthFlows.mjs",
    "test:otp": "node scripts/testOtpAndReset.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
