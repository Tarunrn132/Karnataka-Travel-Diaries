{
  "name": "karnataka-travel-diaries",
  "version": "1.0.0",
  "private": true,
  "description": "Karnataka Travel Diaries - Official Karnataka Discovery Companion built with Vanilla HTML5, CSS3, and JavaScript.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "prisma generate && node scripts/generateSitemap.mjs --prod",
    "build:render": "prisma db push --accept-data-loss && node scripts/seed.mjs && npm run build",
    "sitemap": "node scripts/generateSitemap.mjs --prod",
    "test": "node scripts/generateSitemap.mjs --prod",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
