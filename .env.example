# ==============================================================================
# Karnataka Travel Diaries — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit real secret values to version control!
# ==============================================================================

# Database Connection URL (SQLite for local development, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Server Port & Environment
PORT=3000
NODE_ENV="development"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# 1. AI API KEYS (Primary: Gemini, Fallback: OpenAI)
# ==============================================================================
# Google Gemini API Key (Primary external LLM)
GEMINI_API_KEY=""

# OpenAI API Key (Fallback external LLM)
OPENAI_API_KEY=""

# Generic AI Provider Key (Optional)
AI_API_KEY=""

# ==============================================================================
# 2. ROUTING & DISTANCE API (OPTIONAL)
# ==============================================================================
# Verified road distances across Karnataka national highways (NH-66, NH-75, etc.)
# and ghat winding algorithms are embedded directly into backend/services/geoService.js.
ROUTING_API_KEY=""

# ==============================================================================
# 3. GEOCODING API (OPTIONAL)
# ==============================================================================
# All 31 Karnataka districts and 240+ taluks are indexed locally in data/karnataka-geo-hierarchy.json.
GEOCODING_API_KEY=""

# ==============================================================================
# 4. WEATHER & PLACES ENRICHMENT (OPTIONAL)
# ==============================================================================
WEATHER_API_KEY=""
PLACES_API_KEY=""
