# ==============================================================================
# Karnataka Travel Diaries — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Database Connection URL (SQLite for local development, or PostgreSQL for production)
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# Server Port
PORT=3000

# Node Environment ("development" or "production")
NODE_ENV="production"

# JWT Signing Secret for Session Authentication (REQUIRED - Server-Side Only)
# In production, use a cryptographically strong random string with at least 32 characters.
# Generate one using: openssl rand -base64 32
JWT_SECRET="your_production_jwt_signing_secret_min_32_characters_here"

# Base Application URL (Production Domain placeholder)
NEXT_PUBLIC_APP_URL="https://YOUR-PRODUCTION-DOMAIN.com"

# Production Frontend Origin & CORS Allowed Origins (Comma-separated for multiple domains)
FRONTEND_URL="https://YOUR-PRODUCTION-DOMAIN.com"
CORS_ORIGIN="https://YOUR-PRODUCTION-DOMAIN.com"

# Quick Demo Login Support (MUST be "false" in production)
ENABLE_DEMO_LOGIN="false"

# Default Password for Database Seeder (Required when running 'npm run db:seed')
SEED_DEFAULT_PASSWORD="your_secure_seed_password_here"

# ==============================================================================
# FIREBASE AUTHENTICATION (PRIMARY AUTHENTICATION PROVIDER)
# ==============================================================================
# Client-Side Configuration (Public / Safe for Browser Web SDK)
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps -> Web app
FIREBASE_API_KEY="your_firebase_web_api_key_here"
FIREBASE_AUTH_DOMAIN="karnataka-travel-diaries.firebaseapp.com"
FIREBASE_PROJECT_ID="karnataka-travel-diaries"
FIREBASE_STORAGE_BUCKET="karnataka-travel-diaries.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id_here"
FIREBASE_APP_ID="your_firebase_web_app_id_here"

# Server-Side Configuration: Firebase Admin SDK (Private - NEVER commit to git!)
# Option A: Direct environment variables from downloaded Service Account JSON:
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@karnataka-travel-diaries.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Or relative path to Service Account JSON keyfile:
# FIREBASE_SERVICE_ACCOUNT_KEY="./config/firebase-service-account.json"

# ==============================================================================
# OPTIONAL AUXILIARY PROVIDERS
# ==============================================================================

# --- Mobile Phone SMS OTP Provider ---
# Options: "console" (development console logger), "twilio", "fast2sms"
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- WhatsApp Business Verification Provider ---
# Options: "console" (development console logger), "meta" (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER="console"
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_API_KEY="your_meta_system_user_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"

# --- Transactional Email Provider (Password Reset) ---
# Options: "console" (development console logger), "smtp"
EMAIL_PROVIDER="console"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_specific_password"
FROM_EMAIL="Karnataka Travel Diaries <noreply@karnatakadiaries.com>"

